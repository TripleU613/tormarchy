#!/usr/bin/env bash
#
# Bumps the patch version whenever a commit touches anything but the manifest.
#
# Why here and not in a workflow: the release job runs as the Actions bot, which
# has write access but is not an administrator, and branch protection requires
# the Checks status before anything lands on master. A bot-authored version bump
# is therefore rejected every time. Doing it at commit time sidesteps that
# entirely -- the bump is part of the commit that gets reviewed and pushed.
#
# The auto-release workflow tags whatever version the manifest arrives with and
# skips when that version already has a tag, so one push is one release however
# many commits it carries.
#
# Choose a minor or major bump by editing "version" in manifest.json yourself;
# this only ever touches the patch field, and only when it has to.

set -euo pipefail

# The manifest, the binaries and the lockfile carry one version: setup fetches
# the release by the manifest's, and refuses a binary that says otherwise.
set_version() {
  python3 - "$1" <<'PY'
import json, pathlib, re, sys
v = sys.argv[1]
p = pathlib.Path("manifest.json")
m = json.loads(p.read_text())
m["version"] = v
p.write_text(json.dumps(m, indent=2, ensure_ascii=False) + "\n")
c = pathlib.Path("Cargo.toml")
c.write_text(re.sub(r'(\[workspace\.package\]\nversion = ")[^"]*(")', r"\g<1>" + v + r"\g<2>", c.read_text(), count=1))
PY
  cargo update --workspace --offline --quiet 2>/dev/null || cargo generate-lockfile --offline --quiet 2>/dev/null || true
  git add manifest.json Cargo.toml Cargo.lock
}

staged=$(git diff --cached --name-only)
[[ -n $staged ]] || exit 0

# A commit that only edits the manifest is either a deliberate version choice or
# this hook's own work. Either way, leave it alone.
if [[ $(printf '%s\n' "$staged" | grep -vcE '^(manifest\.json|Cargo\.toml|Cargo\.lock)$') -eq 0 ]]; then
  exit 0
fi

# Nothing user-facing changed, so nothing to release.
if ! printf '%s\n' "$staged" | grep -qvE '^(README\.md|CONTRIBUTING\.md|LICENSE|\.gitignore|docs/|assets/|\.github/|tests/|Makefile|\.githooks/)'; then
  exit 0
fi

# Pinning a published release in setup (its PINNED_* lines and nothing else)
# records that release; bumping here would publish a new one setup doesn't pin.
shipping=$(printf '%s\n' "$staged" | grep -vE '^(README\.md|CONTRIBUTING\.md|LICENSE|\.gitignore|docs/|assets/|\.github/|tests/|Makefile|\.githooks/)' || true)
if [[ $shipping == setup ]] && ! git diff --cached -U0 -- setup | grep -E '^[-+]' \
    | grep -vE '^(\+\+\+|---) ' | grep -qvE '^[-+]PINNED_(VERSION|COMMIT|SHA256)='; then
  exit 0
fi

current=$(python3 -c 'import json;print(json.load(open("manifest.json"))["version"])')

# Deliberately NOT consulting tags. An earlier version asked
# `git tag --list "v$current"` to spot a hand-set version, but tags created by
# the release workflow live on the remote, and a local clone that has not
# fetched them looks identical to a version nobody has released. That silently
# skipped a bump and the change shipped with no release.
#
# Instead: if this commit itself edits the version, that is a deliberate choice
# and is respected. Otherwise the patch is bumped. No network, no stale state.
staged_version=$current
committed_version=$(git show HEAD:manifest.json 2>/dev/null \
  | python3 -c 'import json,sys;print(json.load(sys.stdin)["version"])' 2>/dev/null || echo "")

if [[ -n $committed_version && $staged_version != "$committed_version" ]]; then
  echo "pre-commit: version set to $staged_version by hand; carrying it to the binaries"
  set_version "$staged_version"
  exit 0
fi

next=$(python3 - "$current" <<'PY'
import sys
major, minor, patch = sys.argv[1].split(".")
print(f"{major}.{minor}.{int(patch) + 1}")
PY
)

set_version "$next"
echo "pre-commit: version $current -> $next (pushing this releases v$next)"
