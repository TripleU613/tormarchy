#!/bin/bash

# Removes everything setup installed. Run as root:
#
#   sudo ~/.config/omarchy/plugins/usher.tor/uninstall
#
# Leaves the tor package and your 'tor' group membership alone unless --purge
# is passed. Safe to run twice.

set -uo pipefail

REPO_DIR=$(dirname "$(readlink -f "$0")")

BIN_DIR=/usr/local/bin
LIB_DIR=/usr/local/lib/tormarchy
TORRC=/etc/tor/torrc
TORRC_DIR=/etc/tor/torrc.d
POLKIT_ACTIONS=/usr/share/polkit-1/actions
POLKIT_RULES=/etc/polkit-1/rules.d
UNIT_DROPIN=/etc/systemd/system/tor.service.d
STATE_DIR=/run/tormarchy
NFT_TABLE=tormarchy

die() { echo "uninstall: $*" >&2; exit 1; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }

PURGE=0
[[ ${1:-} == --purge ]] && PURGE=1
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  echo "Usage: sudo ./uninstall [--purge]"
  echo
  echo "  --purge  also remove the tor package and your 'tor' group membership"
  exit 0
fi

(( EUID == 0 )) || die "run this with sudo"

# FIRST, before anything else is removed. Taking away the helpers while a
# ruleset is still loaded would leave a machine with no network and nothing
# installed that knows how to give it back.
step "Removing any firewall rules"
# Ask before acting rather than the add-then-delete idempotency trick: that
# always succeeds, so it can only ever report "removed" -- including when
# nothing was loaded, which is exactly the moment someone reads this line to
# find out whether their firewall was still filtering.
if nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then
  if nft delete table inet "$NFT_TABLE" 2>/dev/null; then
    echo "  removed the $NFT_TABLE table"
  else
    echo "  FAILED to remove the $NFT_TABLE table -- run: nft delete table inet $NFT_TABLE" >&2
  fi
else
  echo "  none were loaded"
fi
rm -rf "$STATE_DIR"

step "Stopping tor"
systemctl stop tor.service 2>/dev/null || true
systemctl disable tor.service 2>/dev/null || true
systemctl reset-failed tor.service 2>/dev/null || true
echo "  stopped and disabled"

step "Removing helpers"
for helper in "$BIN_DIR"/tormarchy-*; do
  [[ -e $helper ]] || continue
  rm -f "$helper"
  echo "  ${helper##*/}"
done
rm -rf "$LIB_DIR"

step "Removing configuration"
rm -f "$TORRC_DIR/00-tormarchy.conf" "$TORRC_DIR/10-tormarchy-exit.conf" \
      "$TORRC_DIR/20-tormarchy-bridges.conf"
echo "  torrc.d snippets"

# Bridge lines are the user's own data, so say so rather than deleting quietly.
if [[ -d /etc/tormarchy ]]; then
  rm -rf /etc/tormarchy
  echo "  removed stored bridge lines (/etc/tormarchy)"
fi

# Only touch the include if our own marker is above it. The tor package may
# ship that same line, and stripping a directive we did not add would break
# every other snippet in the directory.
if [[ -f $TORRC ]] && grep -q '^# Added by tormarchy setup\.$' "$TORRC"; then
  tmp=$(mktemp)
  awk '
    /^# Added by tormarchy setup\.$/ { skip = 2; next }
    skip > 0 && /^%include \/etc\/tor\/torrc\.d$/ { skip = 0; next }
    { skip = 0; print }
  ' "$TORRC" >"$tmp"
  install -m 0644 "$tmp" "$TORRC"
  rm -f "$tmp"
  echo "  removed our include from $TORRC"
else
  echo "  left $TORRC alone (no marker from us)"
fi

rm -f "$UNIT_DROPIN/10-tormarchy.conf"
rmdir "$UNIT_DROPIN" 2>/dev/null || true
systemctl daemon-reload
echo "  systemd drop-in (if any)"

# Drop our tmpfiles override so the packaged 0700 rule takes over again, then
# apply it so the directory is restored now rather than at the next boot.
if [[ -f /etc/tmpfiles.d/tor.conf ]]; then
  rm -f /etc/tmpfiles.d/tor.conf
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/tor.conf 2>/dev/null || true
  echo "  removed the tmpfiles override; /var/lib/tor is mode $(stat -c '%a' /var/lib/tor 2>/dev/null)"
fi

rm -f "$POLKIT_ACTIONS/com.tormarchy.policy" "$POLKIT_RULES/49-tormarchy.rules"
echo "  polkit policy and rule"

if (( PURGE )); then
  step "Purging"
  target_user="${SUDO_USER:-}"
  if [[ -n $target_user ]] && id -nG "$target_user" | tr ' ' '\n' | grep -qx tor; then
    gpasswd -d "$target_user" tor >/dev/null 2>&1 && echo "  removed $target_user from the 'tor' group"
  fi
  pacman -Rns --noconfirm tor 2>/dev/null && echo "  removed the tor package" || echo "  left the tor package (in use or already gone)"
fi

step "Done"
cat <<DONE

  Tormarchy's system side is removed and networking is untouched.
  The plugin itself is still in the bar; remove it with:

    omarchy plugin disable usher.tor

DONE
