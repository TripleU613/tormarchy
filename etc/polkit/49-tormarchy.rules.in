// Managed by tormarchy. Generated by setup from 49-tormarchy.rules.in --
// @TORMARCHY_USER@ is replaced with the user who ran it. Do not edit here;
// re-run setup instead.
//
// Connecting is a bar toggle, and a toggle that asks for a password every time
// is not a toggle. This grants the Tormarchy actions outright to a subject
// clearing three checks at once:
//
//   subject.local              physically at this machine, not over SSH
//   subject.active             the foreground session, not a lingering one
//   subject.user === "..."     the single account that installed this
//
// Pinning the username rather than testing isInGroup("tor") is both tighter
// and more reliable. Tighter because it is one account, not everyone who ends
// up in that group. More reliable because a group check silently fails for any
// session that started before the user was added to it: polkit does not
// resolve the new membership, the rule falls through, and you get a password
// prompt with nothing to explain it. Comparing the username has no such
// lifetime -- it is correct from the first click, with no re-login.
//
// Anything failing these returns NOT_HANDLED and lands on the auth_admin
// defaults in com.tormarchy.policy, so other accounts and remote sessions
// still authenticate.
//
// The cost of a promptless toggle: code already running as you can flip these
// without asking, including tormarchy-disconnect, which drops protection
// silently. Delete this file to be asked every time instead.

polkit.addRule(function(action, subject) {
  // indexOf, not startsWith: polkit's JS engine is not a browser engine.
  if (action.id.indexOf("com.tormarchy.") !== 0) {
    return polkit.Result.NOT_HANDLED;
  }

  if (subject.local && subject.active && subject.user === "@TORMARCHY_USER@") {
    return polkit.Result.YES;
  }

  return polkit.Result.NOT_HANDLED;
});
