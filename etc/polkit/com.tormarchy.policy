<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Managed by tormarchy.

  NOTE TO ANYONE EDITING THIS FILE: a double hyphen is illegal inside an XML
  comment. Writing one here does not merely break the comment, it makes the
  whole document unparseable, polkitd registers none of the actions below, and
  pkexec silently falls back to its generic admin-auth action. The visible
  symptom is a password prompt that no rule can suppress, with nothing logged
  to explain it. Use an em dash instead.

  One action per subcommand that needs root, each pinned to that subcommand as
  the first argument with exec.argv1. pkexec picks the action whose path and
  first argument both match; a subcommand with no action of its own matches
  none of these and gets pkexec's generic action, which always asks for an
  administrator's password and which 49-tormarchy.rules never grants.

  This used to be a single action pinned to the program path alone, and that
  granted every subcommand. browser-exec was one of them, and it becomes
  whatever program it is handed: any process running as the user who installed
  this could take a root shell without a password. The list here is the list
  in tormarchy's PKEXEC_COMMANDS, the dispatcher refuses anything else under
  pkexec as well, and none of these runs a program its caller names.

  These defaults are the FALLBACK, not the normal path. 49-tormarchy.rules
  grants these outright to the local, active user who ran setup, so that person
  is never prompted. Everyone else — another account on the box, or anyone
  arriving over SSH — lands here and has to authenticate. auth_admin_keep
  rather than auth_admin so that, for those users, one prompt covers a short
  burst and switching mode right after connecting does not ask twice.
-->
<policyconfig>
  <vendor>Tormarchy</vendor>
  <vendor_url>https://github.com/TripleU613/tormarchy</vendor_url>

  <action id="com.tormarchy.connect">
    <description>Route traffic through Tor</description>
    <message>Authentication is required to route this machine's traffic through Tor</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">connect</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.tormarchy.disconnect">
    <description>Stop routing traffic through Tor</description>
    <message>Authentication is required to stop routing traffic through Tor</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">disconnect</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.tormarchy.mode">
    <description>Change how traffic is routed through Tor</description>
    <message>Authentication is required to change how traffic is routed through Tor</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">mode</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.tormarchy.exit">
    <description>Choose Tor exit countries</description>
    <message>Authentication is required to change which countries Tor exits from</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">exit</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.tormarchy.bridge">
    <description>Change Tor bridges</description>
    <message>Authentication is required to change the bridges Tor connects through</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">bridge</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.tormarchy.panic">
    <description>Remove every Tormarchy firewall rule</description>
    <message>Authentication is required to remove Tormarchy's firewall rules</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">panic</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.tormarchy.browser-lock">
    <description>Lock a browser to Tor</description>
    <message>Authentication is required to lock a browser to Tor</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">browser-lock</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
