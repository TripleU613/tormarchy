<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Managed by tormarchy.

  NOTE TO ANYONE EDITING THIS FILE: a double hyphen is illegal inside an XML
  comment. Writing one here does not merely break the comment, it makes the
  whole document unparseable, polkitd registers none of the actions below, and
  pkexec silently falls back to its generic admin-auth action. The visible
  symptom is a password prompt that no rule can suppress, with nothing logged
  to explain it. Use an em dash instead.

  One action, not one per operation. There used to be six, pinned to six
  program paths, and they bought nothing: every one of them was granted to the
  same user by the same rule, so the only thing five extra actions added was
  five more places to get this comment wrong.

  Because the action pins a program path and not its arguments, granting it
  grants every subcommand. The two that must not be reachable that way —
  setup and uninstall — refuse to run under pkexec at all and require a real
  terminal with sudo, which keeps this grant scoped to the runtime commands.

  These defaults are the FALLBACK, not the normal path. 49-tormarchy.rules
  grants this outright to the local, active user who ran setup, so that person
  is never prompted. Everyone else — another account on the box, or anyone
  arriving over SSH — lands here and has to authenticate. auth_admin_keep
  rather than auth_admin so that, for those users, one prompt covers a short
  burst and switching mode right after connecting does not ask twice.
-->
<policyconfig>
  <vendor>Tormarchy</vendor>
  <vendor_url>https://github.com/TripleU613/tormarchy</vendor_url>

  <action id="com.tormarchy.manage">
    <description>Manage Tor routing</description>
    <message>Authentication is required to change how this machine routes traffic through Tor</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/tormarchy</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
