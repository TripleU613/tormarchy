#!/bin/bash

# tormarchy:summary=Route traffic through Tor
# tormarchy:args=[lan|strict|socks]
# tormarchy:examples=tormarchy-connect | tormarchy-connect strict

set -uo pipefail

# Resolve the shared library relative to this script, so a repo checkout and the
# installed copy both work. Deliberately NOT an env var: these scripts re-exec
# themselves as root, and a redirectable source path would hand an attacker
# arbitrary code execution as root in a tool whose whole job is not leaking.
_self_dir=$(dirname "$(readlink -f "$0")")
for _candidate in "$_self_dir/../lib/tormarchy/common.sh" "$_self_dir/../lib/common.sh"; do
  [[ -r $_candidate ]] && { source "$_candidate"; break; }
done
unset _self_dir _candidate
type -t die >/dev/null 2>&1 || { echo "${0##*/}: cannot locate common.sh" >&2; exit 1; }

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<USAGE
Usage: tormarchy-connect [--dry-run] [lan|strict|socks]

Starts tor and, for lan and strict, waits for a full bootstrap before applying
the transparent-proxy rules. Defaults to the last mode used, else lan.

  lan     All internet traffic through Tor; local network still reachable.
  strict  As lan, but the local network is dropped too.
  socks   No firewall changes; a SOCKS proxy on 127.0.0.1:$SOCKS_PORT only.
USAGE
  exit 0
fi

# Print and validate the ruleset without touching anything. This is the
# reviewable path: read exactly what would be installed, and let nft check it
# against the kernel, before a single packet is redirected.
dry_run=false
if [[ ${1:-} == --dry-run ]]; then
  dry_run=true
  shift
fi

mode="${1:-}"
[[ -z $mode ]] && mode=$(current_mode)
[[ -z $mode ]] && mode=lan
is_valid_mode "$mode" || die "unknown mode '$mode' (expected: ${VALID_MODES[*]})"

if $dry_run; then
  build_ruleset "$mode"
  echo
  if (( EUID != 0 )); then
    echo "# Syntax check needs root (nft cannot read the kernel cache otherwise)." >&2
    echo "# Re-run as: sudo $(readlink -f "$0") --dry-run $mode" >&2
    exit 0
  fi
  if build_ruleset "$mode" | nft -c -f -; then
    echo "# nft accepts this ruleset. Nothing was applied." >&2
    exit 0
  fi
  die "nft rejected the ruleset (nothing was applied)"
fi

require_root "$mode"

command -v tor >/dev/null 2>&1 || die "tor is not installed -- run setup first"
[[ -f $TORRC_BASE ]] || die "$TORRC_BASE is missing -- run setup first"

# Clear a tripped rate limiter before trying. After a few failed starts systemd
# refuses with "start request repeated too quickly", which describes its own
# bookkeeping rather than anything wrong with tor -- and it then masks the real
# error for as long as the window lasts.
systemctl reset-failed tor.service 2>/dev/null || true

if ! systemctl start tor.service; then
  # Surface tor's own complaint, not systemd's. The useful line is always in the
  # journal, and without this the panel shows a generic failure while the actual
  # cause sits one command away that nobody thinks to run.
  detail=$(journalctl -u tor.service -n 25 --no-pager 2>/dev/null \
    | grep -iE "err|warn|denied|couldn|cannot|unable" \
    | sed 's/^.*\]: //' | tail -2 | tr '\n' ' ')
  die "could not start tor.service${detail:+ -- $detail}"
fi

# Hand the user a readable cookie now that tor has written a fresh one, so the
# panel's bootstrap percentage, circuit path and traffic counters work in this
# session rather than after a logout.
publish_cookie || echo "note: could not publish a readable control cookie; live stats may be empty" >&2

if [[ $mode == socks ]]; then
  # SOCKS mode touches no firewall state, so make sure a previous transparent
  # session is not still filtering underneath us.
  flush_rules
  write_state socks no
  echo "Tor is running. SOCKS proxy on 127.0.0.1:$SOCKS_PORT. No system-wide routing."
  exit 0
fi

# Rules go on only after Tor can actually carry traffic. Applying them earlier
# would redirect everything into a daemon that is not ready, which is
# indistinguishable from a dead network and far more confusing.
wait_bootstrap() {
  local seconds="$1" deadline pct=0
  deadline=$(( $(date +%s) + seconds ))
  while (( $(date +%s) < deadline )); do
    pct=$(bootstrap_progress) || pct=0
    (( pct >= 100 )) && break
    sleep 1
  done
  printf '%s' "$pct"
}

echo "Waiting for Tor to bootstrap..."
pct=$(wait_bootstrap 120)

# A stall looks the same whether the network is slow or is blocking Tor
# outright, and reaching for a bridge is the answer to both. So try it rather
# than making the user diagnose censorship from a percentage -- the same move
# Orbot's SmartConnect makes. Only possible if bridge lines were supplied
# earlier; there is no built-in list to fall back on.
if (( pct < 100 )) && [[ -f $BRIDGE_STASH && ! -f $TORRC_BRIDGES ]]; then
  echo "Stalled at ${pct}%. This network may be blocking Tor; retrying through bridges..."
  if tormarchy-bridge on >/dev/null 2>&1; then
    pct=$(wait_bootstrap 120)
    if (( pct >= 100 )); then
      echo "Bridges worked. Leaving them on for this network."
    else
      # Put it back the way we found it, so the next attempt on a normal
      # network is not silently handicapped by bridges we turned on here.
      tormarchy-bridge off >/dev/null 2>&1 || true
      echo "Bridges did not help either; turned them back off." >&2
    fi
  fi
fi

if (( pct < 100 )); then
  # No rules applied, so the network is untouched and still working. Leave tor
  # running in case it is merely slow; it is harmless without a ruleset.
  hint="No rules applied, networking is unchanged."
  if [[ ! -f $BRIDGE_STASH ]]; then
    hint+=" If this network blocks Tor, add bridges: tormarchy-bridge set"
  fi
  die "tor stalled at ${pct}% bootstrap. $hint"
fi

apply_rules "$mode" || die "could not apply the nftables ruleset. Networking is unchanged."
write_state "$mode" yes

echo "Connected. All traffic now routes through Tor ($mode mode)."
