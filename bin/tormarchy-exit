#!/bin/bash

# tormarchy:summary=Pin or clear the Tor exit country
# tormarchy:args=<country-code>|auto|--list
# tormarchy:examples=tormarchy-exit de | tormarchy-exit auto | tormarchy-exit --list

set -uo pipefail

# Resolve the shared library relative to this script, so a repo checkout and the
# installed copy both work. Deliberately NOT an env var: these scripts re-exec
# themselves as root, and a redirectable source path would hand an attacker
# arbitrary code execution as root in a tool whose whole job is not leaking.
_self_dir=$(dirname "$(readlink -f "$0")")
for _candidate in "$_self_dir/../lib/tormarchy/common.sh" "$_self_dir/../lib/common.sh"; do
  [[ -r $_candidate ]] && { source "$_candidate"; break; }
done
unset _self_dir _candidate
type -t die >/dev/null 2>&1 || { echo "${0##*/}: cannot locate common.sh" >&2; exit 1; }

usage() {
  cat <<USAGE
Usage: tormarchy-exit <country-code>|auto|--list

  <country-code>  Two-letter code, e.g. de. Pins exits to that country.
  auto            Clear the pin and let Tor choose.
  --list          Print country codes that currently have usable exit relays.

Pinning shrinks the pool of relays you can exit through, which is worse for
anonymity than letting Tor choose. Use it to reach geo-locked content, not to
hide better.
USAGE
}

# Read the consensus and ask Tor to geolocate each exit relay. Entirely local:
# the consensus is already on disk and ip-to-country is Tor's own GeoIP data,
# so this makes no network request of its own.
list_exit_countries() {
  local ns ip
  TOR_CONTROL_TIMEOUT=60

  ns=$(tor_control 'GETINFO ns/all') || die "could not reach tor's control port"

  local -a ips=()
  mapfile -t ips < <(awk '
    /^r / { ip = $7; next }
    /^s / {
      if (ip != "" && $0 ~ /(^| )Exit( |$)/ && $0 !~ /BadExit/) print ip
      ip = ""
    }
  ' <<<"$ns" | sort -u)

  (( ${#ips[@]} > 0 )) || die "no exit relays in the consensus yet; is tor bootstrapped?"

  # Chunked rather than one giant pipeline: we only read replies after writing
  # every command, so a few thousand queries in one session would fill the
  # socket buffer in both directions and deadlock against tor.
  local -a queries=()
  local chunk=200 i=0
  for ip in "${ips[@]}"; do
    queries+=("GETINFO ip-to-country/$ip")
    i=$(( i + 1 ))
    if (( ${#queries[@]} >= chunk )); then
      tor_control "${queries[@]}"
      queries=()
    fi
  done
  (( ${#queries[@]} > 0 )) && tor_control "${queries[@]}"
}

case "${1:-}" in
-h | --help | "")
  usage
  exit 0
  ;;
--list)
  tor_is_running || die "tor is not running"
  list_exit_countries \
    | sed -n 's/^250[-+]ip-to-country\/[^=]*=//p' \
    | tr -d '\r' | tr 'A-Z' 'a-z' \
    | grep -x '[a-z][a-z]' \
    | sort -u
  exit 0
  ;;
esac

target="$1"
if [[ $target == auto ]]; then
  :
elif [[ $target =~ ^[A-Za-z][A-Za-z]$ ]]; then
  target=${target,,}
else
  usage >&2
  die "expected a two-letter country code, 'auto', or --list"
fi

require_root "$target"

[[ -d $TORRC_DIR ]] || die "$TORRC_DIR is missing -- run setup first"

if [[ $target == auto ]]; then
  rm -f "$TORRC_EXIT"
else
  cat >"$TORRC_EXIT" <<CONF
# Managed by tormarchy-exit. Remove this file or run 'tormarchy-exit auto'.
ExitNodes {$target}
StrictNodes 1
CONF
  chmod 0644 "$TORRC_EXIT"
fi

if tor_is_running; then
  systemctl reload tor.service 2>/dev/null || systemctl restart tor.service \
    || die "wrote the config but could not reload tor"
  # A reload keeps the cookie, a restart replaces it; refresh either way.
  publish_cookie || true
fi

if [[ $target == auto ]]; then
  echo "Exit country cleared. Tor will choose."
else
  echo "Exits pinned to ${target^^}. New circuits will use it."
fi
