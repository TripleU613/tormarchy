#!/bin/bash

# tormarchy:summary=Set the Tor routing mode
# tormarchy:args=<lan|strict|socks>
# tormarchy:examples=tormarchy-mode strict

set -uo pipefail

# Resolve the shared library relative to this script, so a repo checkout and the
# installed copy both work. Deliberately NOT an env var: these scripts re-exec
# themselves as root, and a redirectable source path would hand an attacker
# arbitrary code execution as root in a tool whose whole job is not leaking.
_self_dir=$(dirname "$(readlink -f "$0")")
for _candidate in "$_self_dir/../lib/tormarchy/common.sh" "$_self_dir/../lib/common.sh"; do
  [[ -r $_candidate ]] && { source "$_candidate"; break; }
done
unset _self_dir _candidate
type -t die >/dev/null 2>&1 || { echo "${0##*/}: cannot locate common.sh" >&2; exit 1; }

if [[ ${1:-} == -h || ${1:-} == --help || $# -eq 0 ]]; then
  cat <<USAGE
Usage: tormarchy-mode <lan|strict|socks>

Records the mode and, when a session is already active, swaps the live ruleset
to match. When nothing is connected this only stores the preference.
USAGE
  exit 0
fi

mode="$1"
is_valid_mode "$mode" || die "unknown mode '$mode' (expected: ${VALID_MODES[*]})"

require_root "$mode"

was_active=false
rules_present && was_active=true

if [[ $mode == socks ]]; then
  flush_rules
  write_state socks no
  echo "Switched to socks mode. System-wide routing is off."
  exit 0
fi

if $was_active; then
  # Replaced in one nft transaction, so there is no unfiltered instant between
  # the old ruleset coming off and the new one going on.
  apply_rules "$mode" || die "could not apply the $mode ruleset; previous rules left in place"
  write_state "$mode" yes
  echo "Switched to $mode mode."
else
  write_state "$mode" no
  echo "Mode set to $mode. Connect to apply it."
fi
