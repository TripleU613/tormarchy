#!/bin/bash

# tormarchy:summary=Stop routing traffic through Tor
# tormarchy:examples=tormarchy-disconnect

set -uo pipefail

# Resolve the shared library relative to this script, so a repo checkout and the
# installed copy both work. Deliberately NOT an env var: these scripts re-exec
# themselves as root, and a redirectable source path would hand an attacker
# arbitrary code execution as root in a tool whose whole job is not leaking.
_self_dir=$(dirname "$(readlink -f "$0")")
for _candidate in "$_self_dir/../lib/tormarchy/common.sh" "$_self_dir/../lib/common.sh"; do
  [[ -r $_candidate ]] && { source "$_candidate"; break; }
done
unset _self_dir _candidate
type -t die >/dev/null 2>&1 || { echo "${0##*/}: cannot locate common.sh" >&2; exit 1; }

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<USAGE
Usage: tormarchy-disconnect

Removes the transparent-proxy rules and stops tor. Networking returns to normal.
USAGE
  exit 0
fi

require_root "$@"

# Rules first, then the daemon. The other order would leave a window where
# traffic is still redirected to a Tor that is no longer listening -- which
# looks exactly like a dead network, but fails closed rather than leaking.
flush_rules
systemctl stop tor.service 2>/dev/null || true

rm -f "$ACTIVE_FILE"
rm -rf "$STATE_DIR"

echo "Disconnected from Tor."
