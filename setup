#!/bin/bash
#
# setup -- install Tormarchy's system side, from a release you can verify.
#
#   sudo ~/.config/omarchy/plugins/tripleu.tor/setup
#
# The panel's Set up button runs it through pkexec instead, so the password is
# asked in Omarchy's own dialog rather than a terminal.
#
# The only script left in this plugin, and deliberately small: everything else
# is the tormarchy and tormarchyd binaries. It fetches the release built for the
# version this plugin declares, verifies it, and hands over to that binary's own
# `setup`, which installs it as root.
#
# The release is pinned here, not looked up: the archive must have exactly the
# SHA-256 below, and its Sigstore signature must have been made by this
# repository's own release workflow, on master, at the commit below. GitHub
# releases and tags can be replaced; this file is what was reviewed, so only the
# build it names installs. Nothing runs as root until both hold.
#
# Each release is two steps: the version bump publishes it, then a commit pins
# it here (the digest is only known once it is built). Until then this refuses.
#
#   sudo ./setup --local target/release   install binaries you built yourself,
#                                         unverified, for development

set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

REPO=TripleU613/tormarchy
WORKFLOW=".github/workflows/auto-release.yml@refs/heads/master"
ISSUER=https://token.actions.githubusercontent.com
PINNED_VERSION=2.0.0
PINNED_COMMIT=4dc964bbceb0901c3c0d06e27fbaa8b94b2b4a89
PINNED_SHA256=d1eefdff657d80fc0bee4819f488f93b7a112ce7aedf8ba718c3bc846a2ee4b4
HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

die() { echo "setup: $*" >&2; exit 1; }

(( EUID == 0 )) || die "run this with sudo: sudo $HERE/setup, or from the panel"
# Through pkexec, polkit can only have used its default exec action, which
# always asks for an administrator's password: the passwordless rule setup
# installs covers com.tormarchy.* alone, and no action of ours names this file.
# So this is sudo with a different dialog. The binary refuses pkexec outright --
# its own runtime commands are the ones that grant reaches -- and only knows
# sudo's way of saying who ran it, so it is told that way.
if [[ -n ${PKEXEC_UID:-} ]]; then
  [[ $PKEXEC_UID =~ ^[0-9]+$ ]] || die "pkexec named no user"
  SUDO_USER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
  [[ -n $SUDO_USER && $SUDO_USER != root ]] || die "could not tell who ran pkexec"
  export SUDO_USER
  unset PKEXEC_UID
fi

version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([0-9][0-9.]*\)".*/\1/p' "$HERE/manifest.json" | head -1)
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "could not read the plugin's version from manifest.json"

work=$(mktemp -d "${TMPDIR:-/tmp}/tormarchy-setup.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
mkdir "$work/bin"

if [[ ${1:-} == --local ]]; then
  dir=${2:?usage: setup --local <directory with tormarchy and tormarchyd>}
  for b in tormarchy tormarchyd; do
    [[ -f $dir/$b && ! -L $dir/$b ]] || die "$dir/$b is missing"
    install -m 0755 "$dir/$b" "$work/bin/$b"
  done
  echo "Installing UNVERIFIED local binaries from $dir"
else
  case $(uname -m) in
  x86_64) arch=x86_64 ;;
  *) die "no release is built for $(uname -m); build it yourself and use --local" ;;
  esac
  [[ $version == "$PINNED_VERSION" ]] \
    || die "this plugin pins release $PINNED_VERSION, not $version; update the plugin, or use --local"
  asset="tormarchy-$version-$arch-linux.tar.gz"
  base="https://github.com/$REPO/releases/download/v$version"

  if ! command -v cosign >/dev/null 2>&1; then
    echo "Installing cosign, to verify the release"
    pacman -S --needed --noconfirm cosign || die "could not install cosign. Run 'omarchy update', then setup again."
  fi

  echo "Fetching Tormarchy $version"
  fetch() {
    curl -fsSL --proto '=https' --tlsv1.2 --max-filesize 33554432 --retry 3 -o "$2" "$1" \
      || die "could not download $1"
  }
  fetch "$base/$asset" "$work/$asset"
  fetch "$base/$asset.sigstore.json" "$work/$asset.sigstore.json"

  # Exactly the reviewed build, whatever the release on GitHub holds today.
  got_sha=$(sha256sum "$work/$asset" | cut -d' ' -f1)
  [[ $got_sha == "$PINNED_SHA256" ]] \
    || die "the release is not the pinned build (sha256 $got_sha); nothing was installed"

  echo "Verifying it was built by github.com/$REPO at $PINNED_COMMIT"
  cosign verify-blob \
    --bundle "$work/$asset.sigstore.json" \
    --certificate-identity "https://github.com/$REPO/$WORKFLOW" \
    --certificate-oidc-issuer "$ISSUER" \
    --certificate-github-workflow-repository "$REPO" \
    --certificate-github-workflow-sha "$PINNED_COMMIT" \
    "$work/$asset" >/dev/null \
    || die "the release did not verify; nothing was installed"

  # Exactly the two files, nothing else, nowhere else.
  tar -xzf "$work/$asset" -C "$work/bin" --no-same-owner --no-same-permissions tormarchy tormarchyd \
    || die "the release archive is not what was expected"
  for b in tormarchy tormarchyd; do
    [[ -f $work/bin/$b && ! -L $work/bin/$b ]] || die "the release is missing $b"
    chmod 0755 "$work/bin/$b"
  done
fi

got=$("$work/bin/tormarchy" version 2>/dev/null || true)
[[ $got == "tormarchy $version" ]] || die "expected tormarchy $version, the binary says '${got:-nothing}'"

"$work/bin/tormarchy" setup
